# Copy to .env and fill with your secrets

# ── LLM Provider ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER=auto
# LLM_PROVIDER options: auto (Gemini → Ollama), gemini, ollama

# ── Research APIs ─────────────────────────────────────────────
PERPLEXITY_API_KEY=your_perplexity_key
NOTEBOOKLM_PROJECT=janani-ai-project
YOUTUBE_CHANNEL_IDS=UC_x5XG1OV2P6uZZ5FSM9Ttw,UCJt6dJdDk6eylC566nIydPQ
REGION=IN
CITY=Warangal

# ── Publishing APIs ───────────────────────────────────────────
DRY_RUN=true
TWITTER_API_KEY=your_twitter_key
TWITTER_API_SECRET=your_twitter_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_TOKEN=your_linkedin_token
LINKEDIN_PAGE_ID=urn:li:organization:0
INSTAGRAM_TOKEN=your_instagram_token
YOUTUBE_API_KEY=your_youtube_key
FACEBOOK_TOKEN=your_facebook_token
BLOG_API_KEY=your_blog_key
NEWSLETTER_API_KEY=your_newsletter_key
